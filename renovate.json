{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>javierbrea/renovate-config"
  ],
  "constraints": {
    "pnpm": "9.4.0",
    "node": "20.20.2"
  },
  "packageRules": [
    {
      "matchFileNames": [
        "test-e2e/cypress-variants/cypress-9/package.json"
      ],
      "matchPackageNames": ["cypress"],
      "allowedVersions": "9.x"
    },
    {
      "matchFileNames": [
        "test-e2e/cypress-variants/cypress-10/package.json"
      ],
      "matchPackageNames": ["cypress"],
      "allowedVersions": "10.x"
    },
    {
      "matchFileNames": [
        "test-e2e/cypress-variants/cypress-11/package.json"
      ],
      "matchPackageNames": ["cypress"],
      "allowedVersions": "11.x"
    },
    {
      "matchFileNames": [
        "test-e2e/cypress-variants/cypress-12/package.json"
      ],
      "matchPackageNames": ["cypress"],
      "allowedVersions": "12.x"
    },
    {
      "matchFileNames": [
        "test-e2e/cypress-variants/cypress-13/package.json"
      ],
      "matchPackageNames": ["cypress"],
      "allowedVersions": "13.x"
    },
    {
      "matchFileNames": [
        "package.json"
      ],
      "matchPackageNames": ["chalk"],
      "allowedVersions": "<5.0.0"
    }
  ]
}
